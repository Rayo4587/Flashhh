# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://nsoveeyxnlfejgqiokhq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# URL pública del sitio (sin "/" al final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://reservas.wellnessattheclub.com

# ---- Correo de confirmación (SMTP) ----
# Ejemplo Google Workspace / Gmail con "contraseña de aplicación":
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
# Ejemplo Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_xxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=reservas@wellnessattheclub.com
SMTP_PASS=contraseña-de-aplicacion
EMAIL_FROM="ATC · Wellness at the Club <reservas@wellnessattheclub.com>"

# Correo(s) que reciben aviso de cada nueva reserva (separados por coma). Opcional.
ADMIN_NOTIFY_EMAILS=reservas@wellnessattheclub.com
